# Example values intentionally disable decisions. Export these variables before launch.
# Generate AGAI_SHARED_TOKEN with: python -c "import secrets; print(secrets.token_urlsafe(32))"
OPENAI_API_KEY=replace_with_your_api_key
OPENAI_MODEL=gpt-6-sol
OPENAI_BASE_URL=https://api.openai.com/v1
AGAI_SHARED_TOKEN=replace_with_a_long_random_secret
MACRO_CSV=../config/macro_feed.csv
DECISION_LOG=./logs/decisions.jsonl
